<resources>
    <!-- Base application theme. -->
    <style name="Theme.GeoTreasure" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="android:windowActionBar">false</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <!--
                <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        -->
        <!-- Customize your theme here. -->
        <!--        <item name="fontFamily">@font/poppins_bold</item>-->
    </style>

    <style name="button_lightblue2" parent="ThemeOverlay.AppCompat">
        <item name="colorAccent">@color/primary</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">18dp</item>
    </style>

    <style name="button_lightBlue" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">278dp</item>
        <item name="android:layout_height">49dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="title" parent="ThemeOverlay.AppCompat">
        <item name="android:fontFamily">"@font/poppins_bold"</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="button_lighterblue" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">278dp</item>
        <item name="android:layout_height">49dp</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">17dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.GeoTreasure.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.GeoTreasure.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

</resources>